# Chatbot Feedback — backend environment for Railway
# Paste into the backend service Variables (Raw Editor) on Railway.
# Root directory of the service must be: backend
# Build: pnpm prisma generate && pnpm build   Start: npx prisma migrate deploy && node dist/main   (already in backend/railway.json)
# After the first successful deploy, run once from the service shell:  pnpm db:seed

# Reference to the Postgres service in the same Railway project (add the PostgreSQL plugin first).
DATABASE_URL=${{Postgres.DATABASE_URL}}

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=onpar
ADMIN_USERNAME=admin
# Your Anthropic key from console.anthropic.com/settings/keys. Never commit the real value.
ANTHROPIC_API_KEY=
FRONTEND_URL=https://chatbot-feedback.vercel.app,https://chatbot-feedback-kanishkhetarpals-projects.vercel.app
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Generate each with: openssl rand -hex 32
JWT_REFRESH_SECRET=
JWT_SECRET=
NIXPACKS_NODE_VERSION=20
NODE_ENV=production

# Widget OTP: every code is 123456 while testing (the default when unset).
# Set it EMPTY before go-live to send real random codes.
# WIDGET_OTP_BYPASS_CODE=123456
