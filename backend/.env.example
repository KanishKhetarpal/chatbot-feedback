# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100

# ── Database ─────────────────────────────────────────────────────────────────
# Local: the docker-compose.yml at the repo root starts Postgres on :5440.
DATABASE_URL="postgresql://chatbot:chatbot@localhost:5440/chatbot_feedback?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Change both in production. Refresh tokens are signed with JWT_REFRESH_SECRET.
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# The admin account, created by `pnpm db:seed` (idempotent — the password is
# written only on first creation; set ADMIN_FORCE_PASSWORD=true to reset it).
# Admins sign in with USERNAME + password. Everyone else signs in with one click
# as a guest — no credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=onpar
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
# ADMIN_FORCE_PASSWORD=false

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the web app is served from. Comma-separated. Used for CORS AND as the
# always-allowed origin for the public chat routes (share links + in-app chat).
FRONTEND_URL=http://localhost:5173

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Public chat rate limits (optional, defaults shown) ───────────────────────
# WIDGET_VISITOR_MAX_MESSAGES=20
# WIDGET_VISITOR_WINDOW_MINUTES=60
# WIDGET_VISITOR_COOLDOWN_MINUTES=60
# WIDGET_AGENT_MAX_MESSAGES=500
# WIDGET_AGENT_WINDOW_MINUTES=60
# WIDGET_AGENT_COOLDOWN_MINUTES=60
# WIDGET_STEP_MAX_MESSAGES=300
# Optional dedicated signing key for visitor tokens (defaults to a hash of JWT_SECRET).
# WIDGET_TOKEN_SECRET=

# ── S3 (optional) — keeps the ORIGINAL uploaded knowledge files for download ─
# Leave blank to run without it: uploads still work, the parsed text is stored
# in Postgres, only the "download original file" button is unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── WhatsApp (phase 2) — the bot on the Acharya number, through Mcube ────────
# Same Mcube account and token the CRM uses (rengage.mcube.com).
MCUBE_WHATSAPP_API_URL=https://rengage.mcube.com
MCUBE_WHATSAPP_BEARER_TOKEN=
# Shared secret Mcube sends as `x-webhook-secret`. Required in production:
# without it the webhook refuses everything (anyone could make the bot message people).
MCUBE_WEBHOOK_SECRET=
# Our own number, digits only, so a provider echo is never answered.
WHATSAPP_BUSINESS_NUMBER=918904893681
# Who the bot may message: comma-separated digits, or * for everyone.
# EMPTY MEANS NOBODY. Keep it to test numbers until go-live.
WHATSAPP_ALLOWED_NUMBERS=
# text = options as a numbered list (works today); mcube = real WhatsApp buttons
# and lists, once Mcube confirms its sendmessage field for interactive messages.
WHATSAPP_INTERACTIVE_MODE=text
# The bot that answers. Unset = the newest trained bot with "WhatsApp" in its name.
# WHATSAPP_AGENT_ID=
# Kill switches. The webhook keeps storing messages when the bot is off.
# WHATSAPP_BOT_ENABLED=true
# WHATSAPP_FOLLOWUPS_ENABLED=true
# Approved templates for follow-ups after the 24h window, in ladder order
# (day 2, day 4, day 7): name:language, add :1 if {{1}} is the first name.
# WHATSAPP_FOLLOWUP_TEMPLATES=
# webhook = Mcube posts to /api/v1/whatsapp/webhook (production).
# poll = read replies and receipts from Mcube's getConversations every few seconds,
# for while the account's one webhook still points at the CRM.
# WHATSAPP_INBOUND_SOURCE=webhook
# WHATSAPP_POLL_SECONDS=5
# Public base of this API, for the callback URL shown on the status page.
# PUBLIC_API_URL=
# Where handoffs (fees, call-backs) are announced so the CRM can create a task.
# CRM_HANDOFF_WEBHOOK_URL=
# CRM_HANDOFF_WEBHOOK_SECRET=
# Owner/tester numbers: a message like "feedback: shorter replies" from these becomes a style note the bot follows.
# WHATSAPP_COACH_NUMBERS=

# ── Widget phone verification (OTP) ──────────────────────────────────────────
# The chat widget verifies a number before it is stored, with the same rules as
# the CRM's student login: a 6-digit code on WhatsApp, valid 10 minutes, three
# codes per number per hour. It goes out on the approved AUTHENTICATION template
# below, through the same Mcube account as the bot, and obeys
# WHATSAPP_ALLOWED_NUMBERS.
WIDGET_OTP_TEMPLATE=student_crm_otp
WIDGET_OTP_TEMPLATE_LANGUAGE=en
# Development only: when the code cannot be delivered (no Mcube, or the number
# is not on the allowlist), return it in the response so the flow stays
# testable. NEVER true in production.
WIDGET_OTP_DEV_ECHO=false
# Development only: fix every code to this value instead of a random one.
WIDGET_OTP_BYPASS_CODE=
